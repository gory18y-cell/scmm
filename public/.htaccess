<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /scm/

    # Abaikan jika berkas atau direktori fisik memang ada
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Arahkan semua request ke index.php
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

